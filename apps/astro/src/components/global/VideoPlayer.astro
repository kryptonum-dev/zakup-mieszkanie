---
import PortableText, { PortableTextQuery, type PortableTextValue } from '@components/ui/portable-text'

export const VideoPlayer_Query = `
  _type == "VideoPlayer" => {
    ${PortableTextQuery('heading')}
    "videoUrl": video.asset -> url,
    "posterUrl": poster.asset -> url,
  },
`

type Props = {
  index: number
  sectionId?: string
  heading: PortableTextValue
  videoUrl: string
  posterUrl?: string
}

const { index, sectionId, heading, videoUrl, posterUrl } = Astro.props
---

<section class="VideoPlayer" id={sectionId}>
  <header>
    <PortableText value={heading} heading={index === 0 ? 'h1' : 'h2'} class="heading" />
  </header>
  <div class="video-wrapper">
    <video
      controls
      playsinline
      preload="metadata"
      poster={posterUrl}
      controlslist="nodownload"
      disablepictureinpicture
      oncontextmenu="return false"
    >
      <source src={videoUrl} type={videoUrl?.includes('.webm') ? 'video/webm' : 'video/mp4'} />
      Twoja przeglądarka nie obsługuje odtwarzania wideo.
    </video>
  </div>
</section>

<style lang="scss">
  .VideoPlayer {
    padding: clamp(1.5rem, calc(2vw / 0.48), 2.5rem) 0;
    max-width: 24rem;
    margin: 0 auto;
    header {
      text-align: center;
      margin-bottom: clamp(0.75rem, calc(1vw / 0.48), 1.25rem);
      .heading {
        font-size: clamp(1.5rem, calc(1.75vw / 0.48), 2rem);
      }
    }
    .video-wrapper {
      width: fit-content;
      margin: 0 auto;
      border-radius: 0.75rem;
      overflow: hidden;
      box-shadow:
        0 4px 6px -1px rgba(0, 0, 0, 0.1),
        0 2px 4px -2px rgba(0, 0, 0, 0.1),
        0 0 0 1px rgba(0, 0, 0, 0.05);
      video {
        width: 100%;
        height: auto;
        max-height: 80vh;
        object-fit: contain;
        display: block;
        background: var(--primary-700, #271607);
      }
    }
  }
</style>
